# Binaries and test output
/bin/
*.exe
*.test
*.out
coverage.*

# Local workspace files (the knowledge repo's scripts/bootstrap.sh writes go.work one level up)
go.work
go.work.sum

# Secrets and editor/OS noise
.env
.env.*
!.env.example
.DS_Store
.idea/
.vscode/

# Web app: dependencies and build output (dist/.keep stays so go:embed always has a match)
/web/node_modules/
/web/dist/*
!/web/dist/.keep
/web/.vitest/

# GoReleaser output
/dist/
