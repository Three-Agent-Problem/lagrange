# Copy to .env (docker compose) or paste into Coolify's environment variables.
POSTGRES_PASSWORD=change-me
# How people and agents reach this server; agent cards and tunnel commands use it.
LAGRANGE_PUBLIC_URL=https://lagrange.example.com
# The first account, created on the first start. Passwords can't be changed in the
# app yet, so pick a strong one.
LAGRANGE_ADMIN_EMAIL=you@example.com
LAGRANGE_ADMIN_PASSWORD=change-me-too
LAGRANGE_ADMIN_NAME=Your Name
LAGRANGE_ADMIN_HANDLE=you
# Host port for lagrange (container port is 8080).
LAGRANGE_PORT=8080
