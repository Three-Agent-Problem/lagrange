# Copy to .env (docker compose) or paste into Coolify's environment variables.
POSTGRES_PASSWORD=change-me
# How people and agents reach this server; agent cards and tunnel commands use it.
LAGRANGE_PUBLIC_URL=https://lagrange.example.com
# The first account, created on the first start. Change its password later in Settings.
LAGRANGE_ADMIN_EMAIL=you@example.com
LAGRANGE_ADMIN_PASSWORD=change-me-too
LAGRANGE_ADMIN_NAME=Your Name
LAGRANGE_ADMIN_HANDLE=you
# Optional: email people when a task waits on them (one-time answer links).
# LAGRANGE_SMTP_URL=smtp://user:password@smtp.example.com:587
# LAGRANGE_SMTP_FROM=lagrange@example.com
# Who can join: invite (default; admins send invitation links) or open (anyone).
# LAGRANGE_SIGNUP=invite
# Optional: "Continue with GitHub/Google". Callbacks: <public URL>/api/auth/github/callback
# and <public URL>/api/auth/google/callback.
# LAGRANGE_GITHUB_CLIENT_ID=
# LAGRANGE_GITHUB_CLIENT_SECRET=
# LAGRANGE_GOOGLE_CLIENT_ID=
# LAGRANGE_GOOGLE_CLIENT_SECRET=
# Host port for lagrange (container port is 8080).
LAGRANGE_PORT=8080
